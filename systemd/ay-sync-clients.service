[Unit]
Description=Enable X-UI syncClients, wait, disable, restart x-ui

[Service]
Type=oneshot
ExecStart=/bin/bash -c '\
  sqlite3 /etc/x-ui/x-ui.db "INSERT INTO settings (key, value) VALUES (\"syncClients\", \"true\") ON CONFLICT(key) DO UPDATE SET value=\"true\";" && \
  sleep 60 && \
  sqlite3 /etc/x-ui/x-ui.db "UPDATE settings SET value=\"false\" WHERE key=\"syncClients\";" && \
  systemctl restart x-ui'