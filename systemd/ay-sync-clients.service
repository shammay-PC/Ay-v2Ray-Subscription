[Unit]
Description=Sync X-UI Clients (temporary)

[Service]
Type=oneshot
ExecStart=/bin/bash -c '\
  sqlite3 /etc/x-ui/x-ui.db "UPDATE settings SET value=1 WHERE key=\x27syncClients\x27;" && \
  sleep 300 && \
  sqlite3 /etc/x-ui/x-ui.db "UPDATE settings SET value=\x27false\x27 WHERE key=\x27syncClients\x27;" && \
  systemctl restart x-ui \
'