[Unit]
Description=Ay Client Sync Service (one-shot)

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'sqlite3 /etc/x-ui/x-ui.db "UPDATE settings SET value=\'true\' WHERE key=\'syncClients\';" && sleep 300 && sqlite3 /etc/x-ui/x-ui.db "UPDATE settings SET value=\'false\' WHERE key=\'syncClients\';" && x-ui restart'